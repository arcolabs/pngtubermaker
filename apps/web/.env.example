# App
NEXT_PUBLIC_APP_NAME=PNGTuberMaker
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_CONTACT_EMAIL=support@pngtubermaker.com
NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/zysPAnvP8f

# Database (self-hosted PG with self-signed cert needs sslmode=require&uselibpqcompat=true)
DATABASE_URL=postgresql://user:password@localhost:5432/pngtubermaker

# Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:4000

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_START_MONTHLY=price_...
STRIPE_PRICE_START_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Scheduled jobs (shared with GitHub Actions secret; never commit the real value)
CRON_SECRET=replace-with-openssl-rand-hex-32

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Generation upstreams (see docs/context/architecture.md)
# GENERATION_ADAPTER=mock uses fake adapters for local development; unset/=production uses real upstreams
GENERATION_ADAPTER=production
ARK_BASE_URL=
ARK_API_KEY=
ARK_SEEDREAM_LITE_ENDPOINT=
PIAPI_BASE_URL=https://api.piapi.ai
PIAPI_KEY=

# Lark alert webhook (generation-health cron)
LARK_WEBHOOK_URL=
